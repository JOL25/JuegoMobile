{
  "name": "juegomobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-dev-client": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.21.6",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.js tests/weapons/*.test.js",
    "typecheck": "tsc --noEmit",
    "assets:audio": "node scripts/generate-sounds.mjs",
    "doctor": "expo-doctor",
    "export:native": "expo export --platform android --platform ios --output-dir dist-native",
    "qa:serve": "node scripts/qa-server.mjs",
    "web:setup": "node node_modules/@shopify/react-native-skia/scripts/setup-canvaskit.js",
    "postinstall": "npm run web:setup",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "lint": "expo lint",
    "assets:icons": "node scripts/generate-icons.mjs",
    "test:visual": "node scripts/visual-smoke.mjs",
    "test:rogue": "node scripts/rogue-smoke.mjs"
  },
  "private": true,
  "type": "module"
}
